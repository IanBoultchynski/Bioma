@page "/auctions"
@using Bioma.Application.DTOs
@using Bioma.Application.Interfaces
@inject IBiomaGameService GameService

@if (_profile != null)
{
    <div style="font-size: 0.72rem; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 0.25rem;">
        COMMUNAUTÉ · ÉCHANGES DE CARTES (TEMPS RÉEL SIGNALR)
    </div>

    <div class="bioma-page-header">
        <div>
            <h1 class="bioma-title">Marché aux enchères</h1>
            <p class="bioma-subtitle">Achetez des cartes aux autres joueurs ou proposez les vôtres.</p>
        </div>

        <div style="display: flex; align-items: center; gap: 1.5rem;">
            <div style="text-align: right;">
                <div style="font-size: 0.72rem; color: var(--text-muted);">Solde disponible</div>
                <div style="font-family: var(--font-serif); font-size: 1.55rem; font-weight: 600;">@_profile.FeuillesCurrency feuilles</div>
            </div>

            <button class="btn-sand" style="width: auto;" @onclick="() => _showSellModal = !_showSellModal">
                <span>+ Mettre une carte en vente</span>
            </button>
        </div>
    </div>

    @if (_showSellModal)
    {
        <section class="bioma-panel" style="margin-bottom: 1.5rem; border-color: var(--border-highlight);">
            <h3 style="font-family: var(--font-serif); font-size: 1.35rem; margin-bottom: 0.9rem;">Mettre un spécimen aux enchères</h3>
            <div style="display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 1rem; align-items: end;">
                <div>
                    <label style="font-size: 0.76rem; color: var(--text-muted);">Carte à vendre</label>
                    <select class="bioma-select" @bind="_cardIdToSell">
                        @foreach (var c in _myCards.Where(x => !x.IsLockedForAuction))
                        {
                            <option value="@c.Id">@c.Name #@c.SpecimenNumber (@c.RarityLabel · PV @c.Hp)</option>
                        }
                    </select>
                </div>
                <div>
                    <label style="font-size: 0.76rem; color: var(--text-muted);">Mise à prix (feuilles)</label>
                    <input type="number" class="bioma-input" @bind="_sellStartingPrice" min="20" />
                </div>
                <div>
                    <label style="font-size: 0.76rem; color: var(--text-muted);">Durée (minutes)</label>
                    <input type="number" class="bioma-input" @bind="_sellDurationMinutes" min="15" />
                </div>
                <button class="btn-sand" style="width: auto;" @onclick="CreateNewAuction">Publier l'annonce →</button>
            </div>
        </section>
    }

    @if (!string.IsNullOrEmpty(_feedbackBanner))
    {
        <div style="background: rgba(108, 192, 137, 0.18); border: 1px solid rgba(108,192,137,0.5); padding: 0.85rem 1.15rem; border-radius: 10px; margin-bottom: 1.25rem; font-size: 0.88rem;">
            @_feedbackBanner
        </div>
    }

    <div class="pill-tabs">
        <button class="pill-tab @(_tab == "all" ? "active" : "")" @onclick='() => _tab = "all"'>Toutes les enchères @_listings.Count</button>
        <button class="pill-tab @(_tab == "bids" ? "active" : "")" @onclick='() => _tab = "bids"'>Mes offres @_listings.Count(l => l.HighestBidderId == _profile.Id)</button>
        <button class="pill-tab @(_tab == "mine" ? "active" : "")" @onclick='() => _tab = "mine"'>Mes annonces @_listings.Count(l => l.SellerId == _profile.Id)</button>
    </div>

    <!-- Barre de recherche & tri (Figma Page 19) -->
    <div class="filter-bar" style="grid-template-columns: 2.2fr 1fr 1fr 1fr;">
        <div>
            <label style="font-size: 0.74rem; color: var(--text-muted);">Rechercher une carte</label>
            <input class="bioma-input" placeholder="Espèce ou vendeur..." @bind="_search" @bind:event="oninput" />
        </div>
        <div>
            <label style="font-size: 0.74rem; color: var(--text-muted);">Catégorie</label>
            <select class="bioma-select" @bind="_categoryFilter">
                <option value="">Toutes les cartes</option>
                <option value="Animal">Animaux</option>
                <option value="Plante">Plantes</option>
                <option value="Hybride">Hybrides</option>
            </select>
        </div>
        <div>
            <label style="font-size: 0.74rem; color: var(--text-muted);">Rareté</label>
            <select class="bioma-select" @bind="_rarityFilter">
                <option value="">Toutes les raretés</option>
                <option value="Commune">Commune</option>
                <option value="Peu commune">Peu commune</option>
                <option value="Rare">Rare</option>
                <option value="Hybride">Hybride</option>
            </select>
        </div>
        <div>
            <label style="font-size: 0.74rem; color: var(--text-muted);">Trier par</label>
            <select class="bioma-select" @bind="_sortOrder">
                <option value="soon">Fin la plus proche</option>
                <option value="price_asc">Prix croissant</option>
                <option value="price_desc">Prix décroissant</option>
            </select>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.85rem;">
        <span>Enchères en cours</span>
        <span>@FilteredListings.Count() cartes disponibles</span>
    </div>

    <!-- Grille 3x2 des lots aux enchères (Figma Page 19) -->
    <div class="auctions-grid">
        @foreach (var lot in FilteredListings)
        {
            <article class="bioma-panel" style="padding: 1.15rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.74rem; color: var(--text-muted); margin-bottom: 0.85rem; padding-bottom: 0.55rem; border-bottom: 1px solid var(--border-subtle);">
                    <span>LOT #@lot.LotNumber</span>
                    <span style="background: rgba(255,255,255,0.06); padding: 0.15rem 0.55rem; border-radius: 999px; color: var(--accent-sand);">
                        @(lot.BidCount > 2 ? $"{lot.BidCount} enchères" : $"Fin dans {lot.TimeRemainingText}")
                    </span>
                </div>

                <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem;">
                    <!-- Miniature Polaroïd à gauche -->
                    <div class="polaroid-card @(lot.IsHybrid ? "hybrid-card" : "")" style="width: 108px; padding: 0.35rem 0.35rem 0.55rem; flex-shrink: 0;">
                        <div class="polaroid-photo-wrap" style="margin-bottom: 0.35rem;">
                            <img class="polaroid-photo" src="@lot.ImageUrl" alt="@lot.CardName" />
                        </div>
                        <div style="font-family: var(--font-serif); font-size: 0.76rem; font-weight: 700; color: #16281E;">@lot.CardName</div>
                        <div style="font-size: 0.62rem; font-style: italic; color: #546A5D;">@lot.ScientificSubtitle</div>
                        <div style="font-size: 0.62rem; color: #3D5446; margin-top: 0.15rem;">@lot.RarityBadge</div>
                    </div>

                    <!-- Infos enchère à droite -->
                    <div style="flex: 1;">
                        <h3 style="font-family: var(--font-serif); font-size: 1.3rem; line-height: 1.2;">@lot.CardName</h3>
                        <div style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.25rem;">@lot.FamilyAndRarity</div>
                        <div style="font-size: 0.76rem; color: var(--text-muted); margin-bottom: 0.65rem;">
                            Vendeur · @lot.SellerPseudo
                            @if (!string.IsNullOrEmpty(lot.HighestBidderPseudo))
                            {
                                <span> · Offre : @lot.HighestBidderPseudo</span>
                            }
                        </div>

                        <div style="font-size: 0.7rem; color: var(--text-muted);">Enchère actuelle</div>
                        <div style="font-family: var(--font-serif); font-size: 1.45rem; font-weight: 600; color: var(--accent-sand);">
                            @lot.CurrentBid feuilles
                        </div>
                        <div style="font-size: 0.72rem; color: var(--text-muted);">
                            @lot.BidCount enchère(s) · Fin dans @lot.TimeRemainingText
                        </div>
                    </div>
                </div>

                <div style="display: flex; gap: 0.65rem;">
                    <button class="btn-sand" style="flex: 1;" @onclick="() => QuickBidOnLot(lot)">
                        <span>Enchérir (+20 🍃)</span>
                    </button>
                    <a href="/collection" class="btn-outline" style="width: auto;">
                        <span>Fiche →</span>
                    </a>
                </div>
            </article>
        }
    </div>
}

@code {
    private PlayerProfileDto? _profile;
    private List<AuctionListingDto> _listings = new();
    private List<CardDto> _myCards = new();
    private string _tab = "all";
    private string _search = string.Empty;
    private string _categoryFilter = string.Empty;
    private string _rarityFilter = string.Empty;
    private string _sortOrder = "soon";
    private bool _showSellModal;
    private Guid _cardIdToSell;
    private int _sellStartingPrice = 150;
    private int _sellDurationMinutes = 60;
    private string? _feedbackBanner;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAuctionData();
    }

    private async Task RefreshAuctionData()
    {
        _profile = await GameService.GetPlayerProfileAsync();
        _listings = await GameService.GetActiveAuctionsAsync();
        _myCards = await GameService.GetPlayerCollectionAsync();
        if (_cardIdToSell == Guid.Empty && _myCards.Count > 0)
        {
            _cardIdToSell = _myCards[0].Id;
        }
    }

    private IEnumerable<AuctionListingDto> FilteredListings
    {
        get
        {
            var q = _listings.AsEnumerable();

            if (_tab == "bids" && _profile != null)
                q = q.Where(l => l.HighestBidderId == _profile.Id);
            else if (_tab == "mine" && _profile != null)
                q = q.Where(l => l.SellerId == _profile.Id);

            if (!string.IsNullOrWhiteSpace(_search))
            {
                q = q.Where(l =>
                    l.CardName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    l.SellerPseudo.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    l.ScientificSubtitle.Contains(_search, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_categoryFilter))
                q = q.Where(l => l.FamilyAndRarity.Contains(_categoryFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(_rarityFilter))
                q = q.Where(l => l.RarityBadge.Equals(_rarityFilter, StringComparison.OrdinalIgnoreCase));

            return _sortOrder switch
            {
                "price_asc" => q.OrderBy(l => l.CurrentBid),
                "price_desc" => q.OrderByDescending(l => l.CurrentBid),
                _ => q.OrderBy(l => l.EndsAt)
            };
        }
    }

    private async Task QuickBidOnLot(AuctionListingDto lot)
    {
        if (_profile == null) return;
        int nextBid = lot.CurrentBid + 20;

        try
        {
            var (updated, refundedId, refundedAmt) = await GameService.PlaceBidAsync(
                new PlaceBidRequestDto(lot.Id, _profile.Id, _profile.Pseudo, nextBid));

            string refundNotice = refundedId.HasValue
                ? $" (L'enchérisseur précédent a été immédiatement remboursé de {refundedAmt} feuilles - User Story #51)"
                : "";
            _feedbackBanner = $"✓ Surenchère en direct validée sur Lot #{updated.LotNumber} ({updated.CardName}) à {updated.CurrentBid} feuilles{refundNotice}.";
            await RefreshAuctionData();
        }
        catch (Exception ex)
        {
            _feedbackBanner = $"⚠️ {ex.Message}";
        }
    }

    private async Task CreateNewAuction()
    {
        if (_profile == null || _cardIdToSell == Guid.Empty) return;
        var created = await GameService.CreateAuctionAsync(new CreateAuctionRequestDto(
            _profile.Id,
            _cardIdToSell,
            _sellStartingPrice,
            _sellDurationMinutes
        ));
        _showSellModal = false;
        _feedbackBanner = $"✓ Lot #{created.LotNumber} ({created.CardName}) mis aux enchères à {created.CurrentBid} feuilles !";
        await RefreshAuctionData();
    }
}
