@page "/quiz"
@implements IDisposable
@using Bioma.Application.DTOs
@using Bioma.Application.Interfaces
@using Bioma.Domain.Enums
@inject IQuizService QuizService
@inject IUserProfileService UserService
@inject UserSessionState Session

@*
    Épique 4 : Quiz Chronométré (US-22 à US-26)
    - US-22 : Questions aléatoires basées uniquement sur les cartes du catalogue Bioma
    - US-23 : Chronomètre strict et équitable vérifié côté serveur
    - US-24 : Validation instantanée de la réponse avec explication scientifique
    - US-25 : Récompense en crédits et en XP en cas de bonne réponse
    - US-26 : Perte de la récompense et animation d'erreur visuelle en cas de dépassement du temps imparti
    - Quota : 1 session quotidienne de 3 questions aléatoires par jour
*@

<div class="bioma-page-header">
    <div>
        <h1 class="bioma-title">Quiz Biologique Quotidien</h1>
        <p class="bioma-subtitle">
            Testez vos connaissances sur les espèces du catalogue Bioma sous chronomètre strict pour gagner des crédits et de l'XP.
        </p>
    </div>

    <div style="display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
        @if (_dailyStatus is not null)
        {
            <div class="bioma-stat-counter">
                <span class="bioma-stat-number">@_dailyStatus.QuestionsAnsweredToday / @_dailyStatus.DailyMaxQuestions</span>
                <div style="text-align: left; font-size: 0.74rem; color: var(--figma-text-soft); line-height: 1.35;">
                    <div>questions du jour</div>
                    <div style="color: var(--figma-text-muted); font-size: 0.68rem;">Prochain quiz : @_dailyStatus.NextResetCountdownText</div>
                </div>
            </div>
        }
    </div>
</div>

@if (_dailyStatus is null)
{
    <p style="color: var(--figma-text-muted);">Chargement du quiz quotidien…</p>
}
else if (!_dailyStatus.CanPlayToday && _currentQuestion is null && _lastResult is null)
{
    <!-- ÉTAT : QUOTA QUOTIDIEN ATTEINT -->
    <section class="bioma-panel" style="text-align: center; padding: 2.75rem 1.75rem; max-width: 720px; margin: 0 auto 2rem;">
        <div style="display: inline-block; padding: 0.25rem 0.85rem; border-radius: 999px; background: rgba(222, 184, 97, 0.16); border: 1px solid var(--figma-gold); color: var(--figma-gold); font-size: 0.74rem; font-weight: 700; margin-bottom: 0.85rem;">
            SESSION QUOTIDIENNE TERMINÉE (@_dailyStatus.QuestionsAnsweredToday / @_dailyStatus.DailyMaxQuestions)
        </div>

        <h2 style="font-family: var(--font-serif); font-size: 1.85rem; margin-bottom: 0.45rem;">
            Rendez-vous demain pour un nouveau Quiz
        </h2>
        <p style="font-size: 0.88rem; color: var(--figma-text-soft); max-width: 520px; margin: 0 auto 1.35rem;">
            Vous avez complété votre session quotidienne sur les espèces du catalogue Bioma.
            Prochaine réinitialisation automatique dans <strong>@_dailyStatus.NextResetCountdownText</strong>.
        </p>

        <div style="display: flex; justify-content: center; gap: 1.25rem; flex-wrap: wrap; margin-bottom: 1.65rem;">
            <div style="background: rgba(15, 32, 22, 0.7); border: 1px solid var(--figma-border-strong); border-radius: 8px; padding: 0.75rem 1.25rem;">
                <div style="font-family: var(--font-serif); font-size: 1.5rem; font-weight: 700; color: var(--figma-green-accent);">
                    @_dailyStatus.TotalCorrectToday / @_dailyStatus.DailyMaxQuestions
                </div>
                <div style="font-size: 0.72rem; color: var(--figma-text-muted);">Bonnes réponses aujourd'hui</div>
            </div>

            <div style="background: rgba(15, 32, 22, 0.7); border: 1px solid var(--figma-border-strong); border-radius: 8px; padding: 0.75rem 1.25rem;">
                <div style="font-family: var(--font-serif); font-size: 1.5rem; font-weight: 700; color: var(--figma-gold);">
                    +@_dailyStatus.TotalCurrencyEarnedToday crédits
                </div>
                <div style="font-size: 0.72rem; color: var(--figma-text-muted);">Monnaie gagnée aujourd'hui</div>
            </div>

            <div style="background: rgba(15, 32, 22, 0.7); border: 1px solid var(--figma-border-strong); border-radius: 8px; padding: 0.75rem 1.25rem;">
                <div style="font-family: var(--font-serif); font-size: 1.5rem; font-weight: 700; color: var(--figma-cream);">
                    +@_dailyStatus.TotalXpEarnedToday XP
                </div>
                <div style="font-size: 0.72rem; color: var(--figma-text-muted);">Expérience gagnée aujourd'hui</div>
            </div>
        </div>

        <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/tirage" class="btn-sand" style="width: auto; padding: 0.65rem 1.3rem;">
                <span>Dépenser mes crédits au Tirage</span>
            </a>
            <button type="button" class="btn-outline" @onclick="ResetDailyQuotaForDemoAsync">
                <span>Réinitialiser le quota quotidien (Mode Démo)</span>
            </button>
        </div>
    </section>
}
else if (_currentQuestion is not null)
{
    string rarityCss = PolaroidPrint.RarityCss(_currentQuestion.SpeciesRarity);
    double percentRemaining = Math.Clamp((_remainingSeconds / _currentQuestion.TimeLimitSeconds) * 100.0, 0, 100);
    string timerColor = _remainingSeconds <= 3.5
        ? "#EF4444"
        : _remainingSeconds <= 6.5
            ? "#F59E0B"
            : "#34D399";

    <div class="refuge-grid" style="grid-template-columns: 1fr 1.25fr; gap: 2rem; align-items: start;">
        <!-- COLONNE GAUCHE : Visuel de la carte du catalogue interrogée -->
        <section class="bioma-panel" style="display: flex; flex-direction: column; align-items: center;">
            <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem;">
                <span style="font-size: 0.72rem; font-weight: 600; color: var(--figma-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">
                    Spécimen du Catalogue Bioma
                </span>
                <span class="rarity-badge @rarityCss">
                    @(_lastResult is not null ? _currentQuestion.SpeciesRarityLabel : "Catalogue")
                </span>
            </div>

            <div style="width: 100%; max-width: 340px; aspect-ratio: 4 / 3; border-radius: 8px; overflow: hidden; border: 2px solid var(--figma-border-strong); background: #0d1b13; margin-bottom: 1rem; box-shadow: 0 10px 24px rgba(0,0,0,0.35);">
                <img src="@_currentQuestion.SpeciesImageUrl"
                     alt="Spécimen du quiz"
                     style="width: 100%; height: 100%; object-fit: cover; display: block;" />
            </div>

            @if (_lastResult?.CatalogueCard is not null)
            {
                <div style="width: 100%; padding: 0.75rem 0.95rem; border-radius: 8px; background: rgba(12, 26, 18, 0.65); border: 1px solid var(--figma-border-strong); text-align: left;">
                    <div style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 700; color: var(--figma-text);">
                        @_lastResult.CatalogueCard.Name
                        <span style="font-weight: 400; font-style: italic; font-size: 0.85rem; color: var(--figma-text-soft);">
                            (@_lastResult.CatalogueCard.ScientificSubtitle)
                        </span>
                    </div>
                    <div style="font-size: 0.74rem; color: var(--figma-text-soft); margin-top: 0.2rem;">
                        Famille : @_lastResult.CatalogueCard.FamilyName · @_lastResult.CatalogueCard.NaturalOccurrencesCount.ToString("N0") observations mondiales · ATK @_lastResult.CatalogueCard.BaseAttack
                    </div>
                </div>
            }
            else
            {
                <div style="font-size: 0.78rem; color: var(--figma-text-muted); text-align: center;">
                    Identifiez les caractéristiques biologiques de cette carte du catalogue avant la fin du décompte.
                </div>
            }
        </section>

        <!-- COLONNE DROITE : Chronomètre strict, Question aléatoire & Validation instantanée -->
        <section class="bioma-panel @(_lastResult?.IsTimeOut == true ? "quiz-timeout-alert" : "")">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.55rem;">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                    <span class="bioma-currency-pill" style="font-size: 0.72rem; padding: 0.2rem 0.65rem;">
                        Question @_currentQuestion.CurrentQuestionNumber / @_currentQuestion.DailyMaxQuestions
                    </span>
                    <span style="font-size: 0.76rem; color: var(--figma-gold); font-weight: 600;">
                        @_currentQuestion.QuestionCategory
                    </span>
                </div>

                <div style="font-family: var(--font-serif); font-size: 1.35rem; font-weight: 700; color: @timerColor;">
                    @(_remainingSeconds.ToString("F1")) s
                </div>
            </div>

            <!-- Barre du chronomètre -->
            <div class="quiz-timer-track">
                <div class="quiz-timer-fill" style="width: @(percentRemaining.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; background: @timerColor;"></div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem; font-size: 0.75rem; color: var(--figma-text-soft);">
                <span>Récompense en cas de bonne réponse dans les temps :</span>
                <span style="font-weight: 700; color: var(--figma-gold);">
                    +@_currentQuestion.RewardCurrency crédits · +@_currentQuestion.RewardXp XP
                </span>
            </div>

            <h2 style="font-family: var(--font-serif); font-size: 1.55rem; line-height: 1.3; margin-bottom: 1.35rem; color: var(--figma-text);">
                @_currentQuestion.QuestionText
            </h2>

            <!-- Les 4 propositions -->
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                @for (int i = 0; i < _currentQuestion.Choices.Count; i++)
                {
                    int idx = i;
                    string stateClass = string.Empty;
                    if (_lastResult is not null)
                    {
                        if (idx == _lastResult.CorrectChoiceIndex)
                        {
                            stateClass = "correct";
                        }
                        else if (idx == _lastResult.SelectedChoiceIndex && !_lastResult.IsCorrect)
                        {
                            stateClass = "wrong";
                        }
                    }

                    <button type="button"
                            class="quiz-choice-btn @stateClass"
                            disabled="@(_lastResult is not null || _isSubmitting)"
                            @onclick="() => SubmitChoiceAsync(idx)">
                        <span>@_currentQuestion.Choices[idx]</span>
                        @if (_lastResult is not null && idx == _lastResult.CorrectChoiceIndex)
                        {
                            <span style="font-size: 0.74rem; font-weight: 700; color: #6EE7B7;">Bonne réponse</span>
                        }
                        else if (_lastResult is not null && idx == _lastResult.SelectedChoiceIndex && !_lastResult.IsCorrect)
                        {
                            <span style="font-size: 0.74rem; font-weight: 700; color: #FCA5A5;">Votre choix</span>
                        }
                    </button>
                }
            </div>

            <!-- Résultat instantané & Animation d'échec si temps dépassé (US-24, US-25, US-26) -->
            @if (_lastResult is not null)
            {
                <div style="margin-top: 1.25rem; padding: 1rem 1.15rem; border-radius: 8px; background: @(_lastResult.IsCorrect ? "rgba(16, 185, 129, 0.16)" : "rgba(239, 68, 68, 0.20)"); border: 1.5px solid @(_lastResult.IsCorrect ? "#34D399" : "#EF4444");">
                    <div style="font-weight: 700; font-size: 0.95rem; color: @(_lastResult.IsCorrect ? "#6EE7B7" : "#FCA5A5"); margin-bottom: 0.35rem;">
                        @_lastResult.StatusTitle
                    </div>

                    @if (_lastResult.IsTimeOut)
                    {
                        <div style="font-size: 0.8rem; color: #FECACA; margin-bottom: 0.45rem; font-weight: 600;">
                            Le délai de @_lastResult.TimeLimitSeconds secondes a été dépassé : la récompense de +@_currentQuestion.RewardCurrency crédits et +@_currentQuestion.RewardXp XP est perdue.
                        </div>
                    }

                    <p style="font-size: 0.82rem; color: var(--figma-text); line-height: 1.45; margin-bottom: 0.9rem;">
                        @_lastResult.ScientificExplanation
                    </p>

                    @if (_dailyStatus.CanPlayToday)
                    {
                        <button type="button" class="btn-sand" style="width: auto; padding: 0.55rem 1.2rem;" @onclick="StartNextQuestionAsync">
                            <span>Question aléatoire suivante (@(_dailyStatus.QuestionsAnsweredToday + 1) / @_dailyStatus.DailyMaxQuestions)</span>
                        </button>
                    }
                    else
                    {
                        <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
                            <button type="button" class="btn-sand" style="width: auto; padding: 0.55rem 1.2rem;" @onclick="FinishDailySessionView">
                                <span>Voir mon bilan quotidien</span>
                            </button>
                            <button type="button" class="btn-outline" style="width: auto; padding: 0.55rem 1rem;" @onclick="ResetDailyQuotaForDemoAsync">
                                <span>Rejouer une session (Mode Démo)</span>
                            </button>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

<!-- HISTORIQUE DES DERNIÈRES RÉPONSES DU JOUEUR -->
@if (_dailyStatus is not null && _dailyStatus.RecentAttempts.Count > 0)
{
    <section class="bioma-panel" style="margin-top: 2rem;">
        <div class="figma-section-header" style="margin-bottom: 0.85rem;">
            <h2 class="figma-section-title">Historique de vos Quiz Chronométrés</h2>
            <span style="font-size: 0.72rem; color: var(--figma-gold);">Synchronisé Supabase</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.55rem;">
            @foreach (var item in _dailyStatus.RecentAttempts)
            {
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding: 0.65rem 0.9rem; border-radius: 6px; background: rgba(12, 26, 18, 0.55); border: 1px solid var(--figma-border); font-size: 0.8rem;">
                    <div>
                        <div style="font-weight: 600; color: var(--figma-text);">@item.QuestionText</div>
                        <div style="font-size: 0.7rem; color: var(--figma-text-muted);">
                            Temps de réponse : @item.ElapsedSeconds.ToString("F1") s · @item.AnsweredAt.ToLocalTime().ToString("dd/MM à HH:mm")
                        </div>
                    </div>

                    <div style="font-weight: 700; font-size: 0.78rem; color: @(item.IsCorrect ? "#34D399" : "#FCA5A5");">
                        @if (item.IsCorrect)
                        {
                            <span>Succès (+@item.EarnedCurrency crédits · +@item.EarnedXp XP)</span>
                        }
                        else if (item.IsTimeOut)
                        {
                            <span>Temps dépassé (0 crédit)</span>
                        }
                        else
                        {
                            <span>Réponse incorrecte (0 crédit)</span>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}

@code {
    private static readonly Guid DefaultDemoPlayerId = Guid.Parse("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa");

    private QuizDailyStatusDto? _dailyStatus;
    private QuizQuestionViewDto? _currentQuestion;
    private QuizAnswerResultDto? _lastResult;
    private double _remainingSeconds = 12.0;
    private bool _isSubmitting;
    private System.Threading.Timer? _countdownTimer;
    private DateTimeOffset _questionStartedLocal;

    private Guid ActivePlayerId => Session.CurrentProfile?.Id ?? DefaultDemoPlayerId;

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentProfile is null)
        {
            var profile = await UserService.GetProfileWithInventoryAsync(DefaultDemoPlayerId);
            if (profile is not null)
            {
                Session.SetSession(profile);
            }
        }

        await LoadStatusAndStartIfAvailableAsync();
    }

    private async Task LoadStatusAndStartIfAvailableAsync()
    {
        _dailyStatus = await QuizService.GetDailyStatusAsync(ActivePlayerId);
        if (_dailyStatus.CanPlayToday)
        {
            await StartNextQuestionAsync();
        }
        else
        {
            _currentQuestion = null;
            _lastResult = null;
        }
    }

    private async Task StartNextQuestionAsync()
    {
        StopTimer();
        _lastResult = null;
        _isSubmitting = false;

        _currentQuestion = await QuizService.StartRandomCatalogueQuestionAsync(ActivePlayerId);
        if (_currentQuestion is not null)
        {
            _remainingSeconds = _currentQuestion.TimeLimitSeconds;
            _questionStartedLocal = DateTimeOffset.UtcNow;

            _countdownTimer = new System.Threading.Timer(async _ =>
            {
                if (_currentQuestion is null || _lastResult is not null || _isSubmitting) return;

                double elapsed = (DateTimeOffset.UtcNow - _questionStartedLocal).TotalSeconds;
                double left = Math.Max(0.0, _currentQuestion.TimeLimitSeconds - elapsed);
                _remainingSeconds = Math.Round(left, 1);

                if (_remainingSeconds <= 0.0)
                {
                    StopTimer();
                    await InvokeAsync(async () => await SubmitChoiceAsync(-1));
                }
                else
                {
                    await InvokeAsync(StateHasChanged);
                }
            }, null, 200, 200);
        }
    }

    private async Task SubmitChoiceAsync(int choiceIndex)
    {
        if (_currentQuestion is null || _lastResult is not null || _isSubmitting) return;
        _isSubmitting = true;
        StopTimer();

        try
        {
            _lastResult = await QuizService.SubmitAnswerAsync(new SubmitQuizAnswerDto(
                ActivePlayerId,
                _currentQuestion.SessionToken,
                _currentQuestion.QuestionId,
                choiceIndex
            ));

            _dailyStatus = await QuizService.GetDailyStatusAsync(ActivePlayerId);

            var updatedProfile = await UserService.GetProfileWithInventoryAsync(ActivePlayerId);
            if (updatedProfile is not null)
            {
                Session.SetSession(updatedProfile, Session.AuthToken);
            }
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void FinishDailySessionView()
    {
        StopTimer();
        _currentQuestion = null;
        _lastResult = null;
    }

    private async Task ResetDailyQuotaForDemoAsync()
    {
        StopTimer();
        await QuizService.ResetDailyQuotaForDemoAsync(ActivePlayerId);
        await LoadStatusAndStartIfAvailableAsync();
    }

    private void StopTimer()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
    }

    public void Dispose()
    {
        StopTimer();
    }
}
