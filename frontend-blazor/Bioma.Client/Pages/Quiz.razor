@page "/quiz"
@implements IDisposable
@using Bioma.Application.DTOs
@using Bioma.Application.Interfaces
@inject IBiomaGameService GameService

<div class="bioma-page-header">
    <div>
        <h1 class="bioma-title">Quiz animaux et plantes</h1>
        <p class="bioma-subtitle">Répondez à 3 questions, avec 10 secondes par question (vérification temporelle côté serveur).</p>
    </div>

    <div class="bioma-stat-counter">
        <button class="btn-outline" @onclick="StartNextQuestion">
            <span>Nouvelle question</span>
            <span>↻</span>
        </button>
    </div>
</div>

@if (_currentQuiz != null)
{
    <div class="refuge-grid" style="align-items: center;">
        <!-- Photographie scientifique à gauche (Figma Page 17) -->
        <div class="bioma-panel" style="padding: 0; overflow: hidden;">
            <img src="@_currentQuiz.ImageUrl"
                 alt="@_currentQuiz.ScientificSubtitle"
                 style="width: 100%; height: 390px; object-fit: cover; display: block;" />

            <div style="padding: 1.25rem 1.5rem;">
                <h2 style="font-family: var(--font-serif); font-size: 1.5rem;">@_currentQuiz.Theme</h2>
                <div style="font-style: italic; font-size: 0.88rem; color: var(--text-muted);">@_currentQuiz.ScientificSubtitle</div>
            </div>
        </div>

        <!-- Question et Chronomètre 10s à droite (Figma Page 17 & Diagramme de séquence p.7) -->
        <div style="padding: 1rem 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">
                <span>Question @(_questionIndex + 1) / 3</span>
                <span>·</span>
                <span style="font-weight: 700; color: @(_remainingSeconds <= 3 ? "#F28B82" : "var(--accent-sand)");">
                    @_remainingSeconds s
                </span>
            </div>

            <div class="xp-bar-track" style="margin-bottom: 1.5rem;">
                <div class="xp-bar-fill" style="width: @(_remainingSeconds * 10)%; transition: width 0.9s linear;"></div>
            </div>

            <h2 style="font-family: var(--font-serif); font-size: 2rem; line-height: 1.25; margin-bottom: 1.65rem;">
                @_currentQuiz.QuestionText
            </h2>

            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                @for (int i = 0; i < _currentQuiz.Options.Count; i++)
                {
                    int optionIdx = i;
                    string borderStyle = "";
                    if (_lastResult != null)
                    {
                        if (optionIdx == _lastResult.CorrectOptionIndex)
                            borderStyle = "border-color: #6CC089; background: rgba(108, 192, 137, 0.22);";
                        else if (optionIdx == _selectedIdx && !_lastResult.IsSuccess)
                            borderStyle = "border-color: #E57373; background: rgba(229, 115, 115, 0.22);";
                    }

                    <button class="btn-outline"
                            style="padding: 1rem 1.25rem; font-size: 0.95rem; @borderStyle"
                            disabled="@(_lastResult != null)"
                            @onclick="() => SubmitAnswer(optionIdx)">
                        <span>@_currentQuiz.Options[optionIdx]</span>
                        <span>→</span>
                    </button>
                }
            </div>

            @if (_lastResult != null)
            {
                <div class="bioma-panel" style="margin-top: 1.35rem; padding: 1rem 1.25rem; border-color: @(_lastResult.IsSuccess ? "#6CC089" : "#E57373");">
                    <div style="font-weight: 600; font-size: 0.95rem; color: @(_lastResult.IsSuccess ? "#8DE0AA" : "#F28B82");">
                        @(_lastResult.IsSuccess ? "✓ Validation Serveur : Succès" : _lastResult.IsTimeout ? "⏱ Exception : Temps écoulé (> 10s)" : "✗ Mauvaise réponse")
                    </div>
                    <p style="font-size: 0.86rem; color: var(--text-cream); margin-top: 0.25rem;">
                        @_lastResult.Message
                    </p>
                    <button class="btn-sand" style="margin-top: 0.85rem;" @onclick="StartNextQuestion">
                        <span>Question suivante</span>
                        <span>→</span>
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    private StartQuizResponseDto? _currentQuiz;
    private SubmitQuizAnswerResponseDto? _lastResult;
    private int _questionIndex = 0;
    private int _remainingSeconds = 10;
    private int _selectedIdx = -1;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadQuizQuestion(0);
    }

    private async Task LoadQuizQuestion(int index)
    {
        _timer?.Dispose();
        _lastResult = null;
        _selectedIdx = -1;
        _remainingSeconds = 10;
        _currentQuiz = await GameService.StartTimedQuizAsync(Guid.Empty, index);

        _timer = new System.Threading.Timer(async _ =>
        {
            if (_remainingSeconds > 0 && _lastResult == null)
            {
                _remainingSeconds--;
                await InvokeAsync(StateHasChanged);
            }
            else if (_remainingSeconds == 0 && _lastResult == null)
            {
                _timer?.Dispose();
                await InvokeAsync(async () => await SubmitAnswer(-1));
            }
        }, null, 1000, 1000);
    }

    private async Task SubmitAnswer(int optionIndex)
    {
        if (_currentQuiz == null || _lastResult != null) return;
        _timer?.Dispose();
        _selectedIdx = optionIndex;

        _lastResult = await GameService.SubmitQuizAnswerAsync(new SubmitQuizAnswerRequestDto(
            _currentQuiz.AttemptId,
            Guid.Empty,
            _currentQuiz.QuestionId,
            optionIndex
        ));
    }

    private async Task StartNextQuestion()
    {
        _questionIndex = (_questionIndex + 1) % 3;
        await LoadQuizQuestion(_questionIndex);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
