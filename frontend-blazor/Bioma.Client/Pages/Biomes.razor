@page "/biomes"
@using Bioma.Application.DTOs
@using Bioma.Application.Interfaces
@using Bioma.Domain.Entities
@inject IBiomaGameService GameService

<div class="bioma-page-header">
    <div>
        <h1 class="bioma-title">Mes biomes</h1>
        <p class="bioma-subtitle">Choisissez un biome et placez jusqu'à 8 cartes.</p>
    </div>

    <button class="btn-outline" @onclick="ToggleFriendVisit">
        <span>@(_visitingFriend ? "Retourner à mes biomes" : "Visiter une vitrine amie")</span>
        <span>→</span>
    </button>
</div>

@if (_visitingFriend)
{
    <section class="bioma-panel" style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div>
                <div style="font-size: 0.7rem; color: var(--figma-gold); letter-spacing: 0.08em;">VITRINE 3D AMIE (USER STORY #63)</div>
                <h2 style="font-family: var(--font-serif); font-size: 1.5rem;">Sanctuaire Boréal de Sora</h2>
            </div>
            <span class="bioma-currency-pill">3 spécimens exposés</span>
        </div>

        <div class="biome-stage" style="border-radius: 6px; background-image: linear-gradient(180deg, rgba(15,32,22,0.1) 0%, rgba(15,32,22,0.7) 100%), url('https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1000&q=80');">
            @foreach (var card in _collection.Take(3))
            {
                <div class="biome-pedestal">
                    <PolaroidCard Card="card" Compact="true" />
                </div>
            }
        </div>
    </section>
}

<div class="biomes-grid">
    @foreach (var biome in _biomes)
    {
        <article class="biome-card-wrapper">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.7rem 1rem; background: #1A3628; border-bottom: 1px solid var(--figma-border); font-size: 0.76rem;">
                <span style="color: var(--figma-text-soft);">@biome.BiomeType</span>
                @if (biome.IsActive)
                {
                    <span style="background: rgba(255, 255, 255, 0.07); color: var(--figma-text); border: 1px solid var(--figma-border-strong); padding: 0.14rem 0.55rem; border-radius: 4px; font-size: 0.68rem;">
                        Vitrine active
                    </span>
                }
            </div>

            <div class="biome-stage" style="height: 225px; background-image: linear-gradient(180deg, rgba(15,32,22,0.08) 0%, rgba(15,32,22,0.65) 100%), url('@biome.BackgroundImageUrl');">
                @foreach (var cardId in biome.ExposedCardIds.Take(3))
                {
                    var card = _collection.FirstOrDefault(c => c.Id == cardId);
                    if (card != null)
                    {
                        <div class="biome-pedestal">
                            <PolaroidCard Card="card" Compact="true" />
                        </div>
                    }
                }
                @for (int emptyIdx = biome.ExposedCardIds.Count; emptyIdx < 3; emptyIdx++)
                {
                    <div class="biome-pedestal">
                        <div class="biome-empty-slot">+</div>
                    </div>
                }
            </div>

            <div style="padding: 1.15rem; background: #173023; border-top: 1px solid var(--figma-border);">
                <h2 style="font-family: var(--font-serif); font-size: 1.35rem; font-weight: 500;">@biome.Name</h2>
                <p style="font-size: 0.76rem; color: var(--figma-text-muted); margin-top: 0.15rem; margin-bottom: 0.9rem;">@biome.Subtitle</p>

                <div style="display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--figma-text-soft); padding-top: 0.65rem; border-top: 1px solid var(--figma-border); margin-bottom: 0.9rem;">
                    <span>@biome.ExposedCardIds.Count carte(s) exposée(s)</span>
                    <span>@Math.Max(0, 3 - biome.ExposedCardIds.Count) emplacement(s)</span>
                </div>

                <button class="@(biome.IsActive ? "btn-sand" : "btn-outline")"
                        style="width: 100%;"
                        @onclick="() => SelectBiomeForEditing(biome)">
                    <span>Entrer &amp; aménager</span>
                    <span>→</span>
                </button>
            </div>
        </article>
    }
</div>

@if (_selectedBiome != null)
{
    <section class="bioma-panel" style="margin-top: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div>
                <div style="font-size: 0.68rem; color: var(--figma-text-muted); letter-spacing: 0.08em;">AMÉNAGEMENT VITRINE 3D</div>
                <h3 style="font-family: var(--font-serif); font-size: 1.35rem;">
                    Socles de « @_selectedBiome.Name » (@_selectedBiome.ExposedCardIds.Count / @_selectedBiome.MaxSlots cartes)
                </h3>
            </div>
            <span style="font-size: 0.78rem; color: var(--figma-text-soft);">Cliquez sur une carte Polaroïd pour l'exposer ou la retirer</span>
        </div>

        <div class="polaroid-grid" style="grid-template-columns: repeat(6, 1fr);">
            @foreach (var card in _collection)
            {
                bool isExposedHere = _selectedBiome.ExposedCardIds.Contains(card.Id);
                <div>
                    <PolaroidCard Card="card" IsSelected="isExposedHere" OnSelect="() => ToggleCardInSelectedBiome(card.Id)" />
                    <div style="margin-top: 0.35rem; text-align: center; font-size: 0.7rem; color: @(isExposedHere ? "#8DE0AA" : "var(--figma-text-muted)");">
                        @(isExposedHere ? "✓ Exposée" : "+ Placer")
                    </div>
                </div>
            }
        </div>
    </section>
}

@code {
    private List<BiomeShowcase> _biomes = new();
    private List<CardDto> _collection = new();
    private BiomeShowcase? _selectedBiome;
    private bool _visitingFriend;

    protected override async Task OnInitializedAsync()
    {
        _biomes = await GameService.GetPlayerBiomesAsync();
        _collection = await GameService.GetPlayerCollectionAsync();
        _selectedBiome = _biomes.FirstOrDefault();
    }

    private void SelectBiomeForEditing(BiomeShowcase biome) => _selectedBiome = biome;

    private void ToggleFriendVisit() => _visitingFriend = !_visitingFriend;

    private async Task ToggleCardInSelectedBiome(Guid cardId)
    {
        if (_selectedBiome == null) return;
        _selectedBiome = await GameService.ToggleCardInBiomeAsync(_selectedBiome.Id, cardId);
        _biomes = await GameService.GetPlayerBiomesAsync();
        _collection = await GameService.GetPlayerCollectionAsync();
    }
}
