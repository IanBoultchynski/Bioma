@inherits LayoutComponentBase
@implements IDisposable
@using Bioma.Application.Interfaces
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject UserSessionState Session
@inject IUserProfileService UserService
@inject ProtectedLocalStorage LocalStorage

<header class="bioma-navbar">
    <div class="bioma-nav-left">
        <a href="/" class="bioma-brand">
            <span>bioma</span>
            <span class="bioma-brand-leaf" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                </svg>
            </span>
        </a>

        <nav class="bioma-nav-links">
            <NavLink class="bioma-nav-link" href="" Match="NavLinkMatch.All">Explorateur &amp; Catalogue</NavLink>
            <NavLink class="bioma-nav-link" href="tirage">Tirage Gacha</NavLink>
            <NavLink class="bioma-nav-link" href="vitrine">Vitrine 3D</NavLink>
            <NavLink class="bioma-nav-link" href="quiz">Quiz Quotidien</NavLink>
            <NavLink class="bioma-nav-link" href="profil">Mon Deck &amp; Profil</NavLink>
        </nav>
    </div>

    <div class="bioma-user-bar">
        @if (Session.CurrentProfile is not null)
        {
            <a href="/tirage" class="bioma-currency-pill" title="Crédits d'exploration">
                <span>@Session.CurrentProfile.Stats.VirtualCurrency crédits</span>
            </a>

            <a href="/profil" class="bioma-currency-pill" title="Mon Deck et mon Inventaire">
                <span>@Session.CurrentProfile.Username</span>
                <span style="opacity: 0.45;">·</span>
                <span style="color: var(--figma-green-accent);">@Session.CurrentProfile.Stats.TotalCardsOwned cartes</span>
            </a>

            <a href="/profil" title="Profil @Session.CurrentProfile.Username">
                <img src="@Session.CurrentProfile.AvatarUrl"
                     alt="@Session.CurrentProfile.Username"
                     class="bioma-avatar"
                     style="object-fit: cover;" />
            </a>
        }
        else
        {
            <a href="/profil" class="btn-outline" style="padding: 0.35rem 0.85rem; font-size: 0.78rem;">
                <span>Se connecter</span>
            </a>
        }
    </div>
</header>

<main class="bioma-container">
    @Body
</main>

@code {
    private static readonly Guid DefaultDemoPlayerId = Guid.Parse("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa");

    protected override void OnInitialized()
    {
        Session.OnChange += HandleSessionChanged;
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Session.CurrentProfile is null)
        {
            try
            {
                Guid targetId = DefaultDemoPlayerId;
                var storedId = await LocalStorage.GetAsync<Guid>("bioma_cloud_player_id");
                if (storedId.Success && storedId.Value != Guid.Empty)
                {
                    targetId = storedId.Value;
                }

                var restoredProfile = await UserService.GetProfileWithInventoryAsync(targetId);
                if (restoredProfile is not null)
                {
                    Session.SetSession(restoredProfile);
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch
            {
                // Ignore si le stockage navigateur n'est pas encore prêt
            }
        }
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }
}
