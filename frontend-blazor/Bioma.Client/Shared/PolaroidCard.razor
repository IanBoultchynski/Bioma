@using Bioma.Application.DTOs

@{
    string dotClass = Card.SourceApi.Equals("GBIF", StringComparison.OrdinalIgnoreCase)
        ? "rare"
        : "peu-commune";
}

<div class="polaroid-card @(IsSelected ? "selected" : "")"
     style="@(Compact ? "width: 112px; padding: 5px 5px 8px;" : "")"
     @onclick="() => OnSelect.InvokeAsync(Card)">
    <div class="polaroid-photo-wrap" style="@(Compact ? "margin-bottom: 5px;" : "")">
        <img class="polaroid-photo" src="@Card.ImageUrl" alt="@Card.Name" loading="lazy" />
    </div>

    <div class="polaroid-name" style="@(Compact ? "font-size: 0.74rem;" : "")">@Card.Name</div>
    <div class="polaroid-scientific" style="@(Compact ? "font-size: 0.6rem; margin-bottom: 4px;" : "")">@Card.ScientificSubtitle</div>

    <div class="polaroid-footer" style="@(Compact ? "font-size: 0.58rem; padding-top: 3px;" : "")">
        <span style="display: inline-flex; align-items: center; gap: 4px;">
            <svg class="polaroid-source-icon @dotClass" width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="12,2 22,12 12,22 2,12" />
            </svg>
            <span>@Card.SourceApi</span>
        </span>
        @if (!Compact)
        {
            <span style="background: rgba(0,0,0,0.08); color: #3E5246; padding: 1px 5px; border-radius: 3px; font-weight: 600; font-size: 0.6rem;">
                @Card.ObservedDate
            </span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CardDto Card { get; set; } = default!;

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public EventCallback<CardDto> OnSelect { get; set; }
}
