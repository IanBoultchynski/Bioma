@using Bioma.Application.DTOs
@using Bioma.Domain.Enums

<div class="polaroid-print rarity-@RarityCss(Card.Rarity) @(Developed ? "is-developed" : "") @Class"
     title="@Card.CommonName (@Card.ScientificName) · @Card.RarityLabel · @Card.NaturalOccurrencesCount.ToString("N0") observations">
    <div class="polaroid-print-window">
        <img src="@Card.ImageUrl" alt="@Card.CommonName" />
        <span class="rarity-badge @RarityCss(Card.Rarity)">
            @Card.RarityLabel
        </span>
    </div>

    <div class="polaroid-print-caption">
        <span class="polaroid-print-name">@Card.CommonName</span>
        @if (Card.IsNew)
        {
            <span class="gacha-new">NOUVEAU</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public GachaDrawnCardDto Card { get; set; } = default!;

    [Parameter]
    public bool Developed { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    public static string RarityCss(CardRarity rarity) => rarity switch
    {
        CardRarity.Commune => "commune",
        CardRarity.PeuCommune => "peu-commune",
        CardRarity.Rare => "rare",
        CardRarity.Legendaire => "legendaire",
        _ => "commune"
    };

    public static string RarityCssFromString(string? rarity) => rarity?.ToLowerInvariant() switch
    {
        "legendaire" or "légendaire" => "legendaire",
        "rare" => "rare",
        "peucommune" or "peu commune" or "peu-commune" => "peu-commune",
        _ => "commune"
    };
}
