@page "/profil"
@implements IDisposable
@using Bioma.Application.DTOs
@using Bioma.Application.Interfaces
@using Bioma.Infrastructure.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IUserProfileService UserService
@inject UserSessionState Session
@inject ProtectedLocalStorage LocalStorage

<div class="bioma-page-header">
    <div>
        <h1 class="bioma-title">Mon Deck &amp; Mon Inventaire</h1>
        <p class="bioma-subtitle">
            Consultez toutes vos cartes possédées, composez votre Deck actif et synchronisez votre profil sur Supabase.
        </p>
    </div>

    <div style="display: flex; align-items: center; gap: 0.75rem;">
        @if (Session.CurrentProfile is not null)
        {
            <span class="bioma-currency-pill" style="border-color: rgba(104, 197, 135, 0.45); color: #68C587;">
                Synchronisé Supabase (@Session.CurrentProfile.LastCloudSyncAt.ToLocalTime().ToString("HH:mm:ss"))
            </span>
        }
        <a href="/tirage" class="btn-sand" style="width: auto; padding: 0.55rem 1.15rem;">
            <span>Tirer des cartes</span>
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_feedbackMessage))
{
    <div style="margin-bottom: 1.25rem; padding: 0.7rem 1rem; border-radius: 8px; background: @(_feedbackSuccess ? "rgba(46, 158, 91, 0.22)" : "rgba(220, 75, 75, 0.22)"); border: 1px solid @(_feedbackSuccess ? "rgba(72, 187, 120, 0.55)" : "rgba(239, 68, 68, 0.55)"); display: flex; align-items: center; justify-content: space-between; font-size: 0.82rem;">
        <span>@_feedbackMessage</span>
        <button type="button" @onclick="() => _feedbackMessage = null" style="background: none; border: none; color: var(--figma-text-soft); cursor: pointer; font-size: 0.78rem;">Fermer</button>
    </div>
}

@if (Session.CurrentProfile is null)
{
    <section class="bioma-panel" style="margin-bottom: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <div>
                <div style="font-weight: 700; font-size: 0.95rem; color: var(--figma-cream);">Accès rapide aux comptes explorateurs</div>
                <div style="font-size: 0.78rem; color: var(--figma-text-soft);">Sélectionnez un compte pour consulter son Deck et son inventaire :</div>
            </div>
            <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
                <button type="button" class="btn-sand" style="width: auto;" @onclick='() => QuickLoginAsync("Ian")'>
                    <span>Continuer en tant que Ian</span>
                </button>
                <button type="button" class="btn-outline" style="width: auto;" @onclick='() => QuickLoginAsync("Arfaoumo")'>
                    <span>Continuer en tant que Arfaoumo</span>
                </button>
            </div>
        </div>
    </section>

    <div class="refuge-grid" style="grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start;">
        <section class="bioma-panel">
            <h2 class="figma-section-title" style="margin-bottom: 0.85rem;">Se connecter</h2>
            <div style="display: flex; flex-direction: column; gap: 0.8rem;">
                <div>
                    <label style="display: block; font-size: 0.74rem; color: var(--figma-text-soft); margin-bottom: 0.25rem;">Pseudonyme ou E-mail</label>
                    <input type="text" class="bioma-input" @bind="_loginIdentifier" placeholder="Ex : Ian ou ian@bioma.fr" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.74rem; color: var(--figma-text-soft); margin-bottom: 0.25rem;">Mot de passe</label>
                    <input type="password" class="bioma-input" @bind="_loginPassword" placeholder="Mot de passe" />
                </div>
                <button class="btn-sand" @onclick="ExecuteLoginAsync" disabled="@_isSubmitting">
                    <span>@(_isSubmitting ? "Connexion..." : "Se connecter")</span>
                </button>
            </div>
        </section>

        <section class="bioma-panel">
            <h2 class="figma-section-title" style="margin-bottom: 0.85rem;">Créer un nouveau compte</h2>
            <div style="display: flex; flex-direction: column; gap: 0.8rem;">
                <div>
                    <label style="display: block; font-size: 0.74rem; color: var(--figma-text-soft); margin-bottom: 0.25rem;">Pseudonyme</label>
                    <input type="text" class="bioma-input" @bind="_regUsername" placeholder="Ex : CamilleNaturaliste" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.74rem; color: var(--figma-text-soft); margin-bottom: 0.25rem;">E-mail</label>
                    <input type="email" class="bioma-input" @bind="_regEmail" placeholder="Ex : camille@bioma.fr" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.74rem; color: var(--figma-text-soft); margin-bottom: 0.25rem;">Mot de passe (min. 8 car., Maj, min, chiffre)</label>
                    <input type="password" class="bioma-input" @bind="_regPassword" placeholder="Ex : Bioma2026!" />
                </div>
                <button class="btn-outline" style="width: 100%;" @onclick="ExecuteRegisterAsync" disabled="@_isSubmitting">
                    <span>@(_isSubmitting ? "Création..." : "Créer mon profil sur Supabase")</span>
                </button>
            </div>
        </section>
    </div>
}
else
{
    var profile = Session.CurrentProfile;

    <section class="bioma-panel" style="margin-bottom: 1.5rem; padding: 1.15rem 1.35rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.25rem;">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <img src="@profile.AvatarUrl"
                     alt="@profile.Username"
                     style="width: 56px; height: 56px; border-radius: 50%; border: 2px solid var(--figma-gold); object-fit: cover;" />
                <div>
                    <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                        <h2 style="font-family: var(--font-serif); font-size: 1.55rem; font-weight: 700; color: var(--figma-text);">
                            @profile.Username
                        </h2>
                        <span class="bioma-currency-pill" style="font-size: 0.72rem; padding: 0.15rem 0.6rem;">
                            Niveau @profile.Stats.Level · @profile.Stats.EloRating Elo
                        </span>
                    </div>
                    <div style="font-size: 0.76rem; color: var(--figma-text-soft); margin-top: 0.15rem;">
                        @profile.Email · <strong>@profile.Stats.TotalCardsOwned</strong> carte(s) (@profile.Stats.UniqueSpeciesCount espèces uniques) · <strong>@profile.Stats.VirtualCurrency</strong> crédits
                    </div>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 0.35rem;">
                    @foreach (var emblem in GetBotanicalEmblems(profile.Username))
                    {
                        <button type="button"
                                title="Emblème : @emblem.Label"
                                @onclick="() => SelectEmblemAvatarAsync(emblem.DataUri)"
                                style="width: 30px; height: 30px; border-radius: 50%; padding: 0; border: @(profile.AvatarUrl == emblem.DataUri ? "2px solid var(--figma-gold)" : "1px solid var(--figma-border-strong)"); background: none; cursor: pointer; overflow: hidden;">
                            <img src="@emblem.DataUri" alt="@emblem.Label" style="width: 100%; height: 100%; display: block;" />
                        </button>
                    }
                </div>

                <button type="button" class="btn-outline" style="padding: 0.42rem 0.85rem; font-size: 0.76rem;" @onclick="LogoutAsync">
                    <span>Changer de compte</span>
                </button>
            </div>
        </div>
    </section>

    <section class="bioma-panel">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
            <div class="pill-tabs" style="margin-bottom: 0;">
                <button type="button"
                        class="pill-tab @(_inventoryViewMode == "all" ? "active" : "")"
                        @onclick='() => _inventoryViewMode = "all"'>
                    Tout mon inventaire (@profile.Inventory.Count)
                </button>
                <button type="button"
                        class="pill-tab @(_inventoryViewMode == "deck" ? "active" : "")"
                        @onclick='() => _inventoryViewMode = "deck"'>
                    Mon Deck Actif (@profile.ActiveDeck.Count)
                </button>
                <button type="button"
                        class="pill-tab @(_inventoryViewMode == "gacha" ? "active" : "")"
                        @onclick='() => _inventoryViewMode = "gacha"'>
                    Obtenues au Tirage (@profile.Inventory.Count(c => c.ObtainedVia == "Gacha"))
                </button>
            </div>

            <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <select class="bioma-select" style="width: auto; padding: 0.4rem 0.65rem; font-size: 0.75rem;" @bind="_inventorySort">
                    <option value="rarity_desc">Trier : Rareté (Légendaire → Commune)</option>
                    <option value="recent">Trier : Plus récentes</option>
                    <option value="atk_desc">Trier : Puissance ATK</option>
                </select>

                <input type="text"
                       class="bioma-input"
                       style="max-width: 210px; padding: 0.4rem 0.7rem;"
                       @bind="_inventorySearch"
                       @bind:event="oninput"
                       placeholder="Rechercher une espèce..." />
            </div>
        </div>

        <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
            @foreach (var rTab in new[]
            {
                ("ALL", "Toutes les raretés", ""),
                ("Legendaire", "Légendaire", "legendaire"),
                ("Rare", "Rare", "rare"),
                ("PeuCommune", "Peu commune", "peu-commune"),
                ("Commune", "Commune", "commune")
            })
            {
                <button type="button"
                        class="pill-tab @(_inventoryRarityFilter == rTab.Item1 ? "active" : "")"
                        style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.73rem; padding: 0.25rem 0.7rem;"
                        @onclick="() => _inventoryRarityFilter = rTab.Item1">
                    @if (!string.IsNullOrEmpty(rTab.Item3))
                    {
                        <span class="polaroid-dot @rTab.Item3" style="margin: 0;"></span>
                    }
                    <span>@rTab.Item2</span>
                </button>
            }
        </div>

        @{
            IEnumerable<PlayerCardDto> sourceList = _inventoryViewMode switch
            {
                "deck"  => profile.ActiveDeck,
                "gacha" => profile.Inventory.Where(c => c.ObtainedVia.Equals("Gacha", StringComparison.OrdinalIgnoreCase)),
                _       => profile.Inventory
            };

            if (_inventoryRarityFilter != "ALL")
            {
                sourceList = sourceList.Where(c => c.Rarity.Equals(_inventoryRarityFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_inventorySearch))
            {
                sourceList = sourceList.Where(c =>
                    c.CommonName.Contains(_inventorySearch, StringComparison.OrdinalIgnoreCase) ||
                    c.ScientificName.Contains(_inventorySearch, StringComparison.OrdinalIgnoreCase) ||
                    c.Family.Contains(_inventorySearch, StringComparison.OrdinalIgnoreCase));
            }

            static int RarityRank(string r) => r.ToLowerInvariant() switch
            {
                "legendaire" => 4,
                "rare"       => 3,
                "peucommune" => 2,
                _            => 1
            };

            var displayedCards = (_inventorySort switch
            {
                "recent"   => sourceList.OrderByDescending(c => c.AcquiredAt),
                "atk_desc" => sourceList.OrderByDescending(c => c.CurrentAttack),
                _          => sourceList.OrderByDescending(c => RarityRank(c.Rarity)).ThenBy(c => c.NaturalOccurrencesCount)
            }).ToList();
        }

        @if (displayedCards.Count == 0)
        {
            <div class="bioma-panel-dark" style="text-align: center; padding: 2.5rem 1.5rem;">
                <div style="font-family: var(--font-serif); font-size: 1.15rem; color: var(--figma-cream); margin-bottom: 0.4rem;">
                    Aucune carte dans cette sélection
                </div>
                <p style="font-size: 0.8rem; color: var(--figma-text-muted); margin-bottom: 1rem;">
                    Lancez un tirage Polaroïd ou explorez le catalogue API pour obtenir de nouvelles espèces.
                </p>
                <a href="/tirage" class="btn-sand" style="display: inline-flex; width: auto;">
                    <span>Ouvrir le Tirage Gacha</span>
                </a>
            </div>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(205px, 1fr)); gap: 1.15rem;">
                @foreach (var card in displayedCards)
                {
                    string rCss = PolaroidPrint.RarityCssFromString(card.Rarity);
                    <div class="polaroid-card rarity-border-@rCss @(card.IsInActiveDeck ? "selected" : "")"
                         style="cursor: default; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div class="polaroid-photo-wrap">
                                <img class="polaroid-photo" src="@card.ImageUrl" alt="@card.CommonName" loading="lazy" />
                                <span class="rarity-badge @rCss" style="position: absolute; top: 6px; right: 6px; font-size: 0.56rem; padding: 2px 7px;">
                                    @card.RarityLabel
                                </span>
                            </div>

                            <div class="polaroid-name" title="@card.CommonName">@card.CommonName</div>
                            <div class="polaroid-scientific" title="@card.ScientificName">@card.ScientificName</div>

                            <div style="font-size: 0.62rem; color: #3D5647; margin-bottom: 0.4rem; font-weight: 600;">
                                @card.NaturalOccurrencesCount.ToString("N0") obs. · ATK @card.CurrentAttack · DEF @card.CurrentDefense
                            </div>

                            <div class="polaroid-footer" style="margin-bottom: 0.5rem;">
                                <span style="display: inline-flex; align-items: center; gap: 4px;">
                                    <span class="polaroid-dot @rCss" style="margin: 0;"></span>
                                    <span>@card.ObtainedVia</span>
                                </span>
                                <span>@card.Family</span>
                            </div>
                        </div>

                        <button type="button"
                                @onclick="() => ToggleDeckStatusAsync(card.Id)"
                                style="width: 100%; padding: 0.45rem 0.6rem; border-radius: 5px; border: none; font-size: 0.73rem; font-weight: 700; cursor: pointer; background: @(card.IsInActiveDeck ? "#1E3B2B" : "#DEB861"); color: @(card.IsInActiveDeck ? "#F5F1E6" : "#15291E");">
                            @(card.IsInActiveDeck ? "Dans le Deck (Retirer)" : "Équiper dans le Deck")
                        </button>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private record BotanicalEmblem(string Label, string DataUri);

    private string _loginIdentifier = string.Empty;
    private string _loginPassword = string.Empty;
    private string _regUsername = string.Empty;
    private string _regEmail = string.Empty;
    private string _regPassword = string.Empty;
    private string _inventorySearch = string.Empty;

    private string _inventoryViewMode = "all";
    private string _inventoryRarityFilter = "ALL";
    private string _inventorySort = "rarity_desc";
    private bool _isSubmitting;
    private string? _feedbackMessage;
    private bool _feedbackSuccess = true;

    protected override void OnInitialized()
    {
        Session.OnChange += HandleSessionChanged;
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentProfile is null)
        {
            var defaultProfile = await UserService.GetProfileWithInventoryAsync(Guid.Parse("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"));
            if (defaultProfile is not null)
            {
                Session.SetSession(defaultProfile);
            }
        }
    }

    private static BotanicalEmblem[] GetBotanicalEmblems(string username) =>
    [
        new("Initiales", UserProfileService.BuildDefaultAvatarSvg(username)),
        new("Sceau Sylvestre", BuildVectorIconSvg(
            "<path d='M80 30 C50 45 40 85 80 130 C120 85 110 45 80 30 Z' fill='%2334D399' opacity='0.85'/><path d='M80 40 L80 120' stroke='%230B1B12' stroke-width='3'/>",
            "%2312291C", "%23DEB861")),
        new("Boussole", BuildVectorIconSvg(
            "<polygon points='80,32 92,72 80,64 68,72' fill='%23DEB861'/><polygon points='80,128 92,88 80,96 68,88' fill='%2358B77E'/>",
            "%23102117", "%23E5C77A")),
        new("Étoile Polaire", BuildVectorIconSvg(
            "<polygon points='80,24 88,68 136,80 88,92 80,136 72,92 24,80 72,68' fill='%23F4EBD4'/>",
            "%2312261B", "%23DEB861"))
    ];

    private static string BuildVectorIconSvg(string innerSvgContent, string bgColorHex, string ringColorHex) =>
        $"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160' viewBox='0 0 160 160'><circle cx='80' cy='80' r='77' fill='{bgColorHex}' stroke='{ringColorHex}' stroke-width='3'/>{innerSvgContent}</svg>";

    private async Task QuickLoginAsync(string username)
    {
        var res = await UserService.RestoreProgressionFromCloudAsync(username);
        if (res.Success && res.Profile is not null)
        {
            Session.SetSession(res.Profile, res.AuthToken);
            await SaveSessionToBrowserAsync(res.Profile.Id);
            _feedbackSuccess = true;
            _feedbackMessage = $"Connecté en tant que {res.Profile.Username} (synchronisé avec Supabase PostgreSQL).";
        }
    }

    private async Task ExecuteLoginAsync()
    {
        _isSubmitting = true;
        try
        {
            var res = await UserService.LoginAsync(new LoginRequestDto(_loginIdentifier.Trim(), _loginPassword));
            _feedbackSuccess = res.Success;
            _feedbackMessage = res.Message;
            if (res.Success && res.Profile is not null)
            {
                Session.SetSession(res.Profile, res.AuthToken);
                await SaveSessionToBrowserAsync(res.Profile.Id);
                _loginPassword = string.Empty;
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ExecuteRegisterAsync()
    {
        _isSubmitting = true;
        try
        {
            var res = await UserService.RegisterAsync(new RegisterUserRequestDto(_regUsername.Trim(), _regEmail.Trim(), _regPassword));
            _feedbackSuccess = res.Success;
            _feedbackMessage = res.Message;
            if (res.Success && res.Profile is not null)
            {
                Session.SetSession(res.Profile, res.AuthToken);
                await SaveSessionToBrowserAsync(res.Profile.Id);
                _regUsername = string.Empty;
                _regEmail = string.Empty;
                _regPassword = string.Empty;
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task LogoutAsync()
    {
        Session.ClearSession();
        try { await LocalStorage.DeleteAsync("bioma_cloud_player_id"); } catch { }
        _feedbackSuccess = true;
        _feedbackMessage = "Vous êtes déconnecté. Choisissez un compte ci-dessous.";
    }

    private async Task SelectEmblemAvatarAsync(string emblemDataUri)
    {
        if (Session.CurrentProfile is null) return;
        var updated = await UserService.UpdateAvatarAsync(Session.CurrentProfile.Id, emblemDataUri);
        if (updated is not null)
        {
            Session.SetSession(updated);
            _feedbackSuccess = true;
            _feedbackMessage = "Avatar mis à jour et synchronisé sur Supabase PostgreSQL.";
        }
    }

    private async Task ToggleDeckStatusAsync(Guid playerCardId)
    {
        if (Session.CurrentProfile is null) return;
        var updated = await UserService.ToggleCardInActiveDeckAsync(Session.CurrentProfile.Id, playerCardId);
        if (updated is not null)
        {
            Session.SetSession(updated);
        }
    }

    private async Task SaveSessionToBrowserAsync(Guid playerId)
    {
        try { await LocalStorage.SetAsync("bioma_cloud_player_id", playerId); } catch { }
    }
}
